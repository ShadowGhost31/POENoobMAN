<local:OverlayWindowBase x:Class="PoeNoobMan.App.Windows.TimerWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="clr-namespace:PoeNoobMan.App.Windows"
                         Title="PoE Noob Man — таймер">
    <Border x:Name="Root" Width="236" CornerRadius="6" Padding="12,6,12,6" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="0.5">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="LastTime" Foreground="{StaticResource OverlayText}" FontFamily="Consolas" FontSize="12" />
                    <TextBlock x:Name="Delta" FontFamily="Consolas" FontSize="12" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="LastLabel" Foreground="{StaticResource OverlayMuted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
            </DockPanel>
            <TextBlock x:Name="Big" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,-2" />
            <Border x:Name="NextRow" BorderBrush="#444441" BorderThickness="0,0.5,0,0" Padding="0,3,0,0" Margin="0,2,0,0">
                <DockPanel>
                    <TextBlock x:Name="NextCompare" DockPanel.Dock="Right" Foreground="{StaticResource OverlayDim}" FontSize="11" />
                    <TextBlock x:Name="NextLabel" Foreground="{StaticResource OverlayDim}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</local:OverlayWindowBase>
