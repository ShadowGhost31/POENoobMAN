<Window x:Class="PoeNoobMan.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoE Noob Man" Width="980" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontSize="13"
        ThemeMode="Dark" Icon="/Assets/icon.ico">
    <Window.Resources>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Бічна панель ================= -->
        <DockPanel Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" Margin="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,12,22">
                <Image Source="/Assets/icon.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PoE Noob Man" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionSmall" Style="{StaticResource Hint}" />
                </StackPanel>
            </StackPanel>

            <!-- Перемикач оверлею завжди під рукою -->
            <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,16">
                <Button x:Name="OverlayButton" Click="OnToggleOverlay" HorizontalAlignment="Stretch" Padding="10,9"
                        Style="{DynamicResource AccentButtonStyle}" />
                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                    <Ellipse x:Name="GameDotSide" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="GameStatusSide" Style="{StaticResource Hint}" />
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="Nav" SelectionChanged="OnNavChanged" Background="Transparent" BorderThickness="0" Margin="8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Tag="Home">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Glyphs}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Огляд" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Build">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Glyphs}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Білд і гайд" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Look">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource Glyphs}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Вигляд оверлею" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Timer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource Glyphs}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Таймер забігу" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Keys">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource Glyphs}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Гарячі клавіші" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Updates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource Glyphs}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Оновлення" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ================= Вміст ================= -->
        <DockPanel Grid.Column="1">
            <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" FontSize="26" FontWeight="SemiBold" Margin="28,20,28,14" />

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="28,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Зберегти" MinWidth="120" Padding="18,7" Click="OnSave" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" />
                    <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,8">
                <Grid>
                    <!-- Огляд -->
                    <StackPanel x:Name="PageHome">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <Border Style="{StaticResource Pill}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="GameDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="GameStatus" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Pill}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="LogDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LogPill" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Pill}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="OverlayDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="OverlayPill" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock x:Name="OverlayErrors" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Гра має бути у режимі Windowed або Windowed Fullscreen. Вікно можна згорнути — оверлей працює, доки програма запущена." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="LiveGuide" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Top" />
                                    <TextBlock Text="Зараз у грі" Style="{StaticResource CardTitle}" />
                                </DockPanel>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Зона" Style="{StaticResource Hint}" />
                                        <TextBlock x:Name="LiveZone" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Рівень" Style="{StaticResource Hint}" />
                                        <TextBlock x:Name="LiveLevel" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Очки дерева" Style="{StaticResource Hint}" />
                                        <TextBlock x:Name="LivePoints" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                </UniformGrid>
                                <ItemsControl x:Name="LiveSteps">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Act}" FontSize="11" />
                                                </Border>
                                                <TextBlock x:Name="T" Text="{Binding Text}" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="LiveNode" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Client.txt і персонаж" Style="{StaticResource CardTitle}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Знайти" Margin="6,0,0,0" Click="OnDetectLog" />
                                    <Button DockPanel.Dock="Right" Content="Огляд…" Margin="6,0,0,0" Click="OnBrowseLog" />
                                    <TextBox x:Name="LogPath" />
                                </DockPanel>
                                <TextBlock x:Name="LogStatus" FontSize="12" Margin="2,4,0,0" />
                                <TextBlock Text="Ім'я персонажа" Margin="0,12,0,4" />
                                <ComboBox x:Name="Character" IsEditable="True" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="За ім'ям фільтруються рядки про рівень, тому мул або інші персонажі не збивають прогрес." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Білд -->
                    <StackPanel x:Name="PageBuild" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Гайд" Style="{StaticResource CardTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Білд" Margin="0,0,0,4" />
                                        <ComboBox x:Name="GuideBox" DisplayMemberPath="Title" SelectionChanged="OnGuideChanged" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Версія" Margin="0,0,0,4" />
                                        <ComboBox x:Name="VersionBox" DisplayMemberPath="Version" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="GuideSource" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Опції білда" Style="{StaticResource CardTitle}" />
                                <ItemsControl x:Name="OptionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                                          SelectedValue="{Binding Selected}" HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Опції фільтрують кроки, ноди і спліти. Прогрес зберігається окремо для кожного гайда і персонажа." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Файли гайдів" Style="{StaticResource CardTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Відкрити папку гайдів" Click="OnOpenGuides" />
                                    <Button Content="Папка даних" Margin="8,0,0,0" Click="OnOpenData" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Новий YAML-файл у папці гайдів одразу з'являється у списку як нова версія." />
                                <TextBlock x:Name="GuideErrors" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Вигляд -->
                    <StackPanel x:Name="PageLook" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Підказки" Style="{StaticResource CardTitle}" Grid.ColumnSpan="3" />
                                <TextBlock Grid.Row="1" Text="Масштаб" Style="{StaticResource Label}" />
                                <Slider x:Name="ScaleSlider" Grid.Row="1" Grid.Column="1" Minimum="0.75" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" Margin="0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Row="2" Text="Непрозорість фону" Style="{StaticResource Label}" />
                                <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" Margin="0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Row="3" Text="Кроків одночасно" Style="{StaticResource Label}" />
                                <Slider x:Name="HintsSlider" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=HintsSlider}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Позиція на екрані гри" Style="{StaticResource CardTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="X, %" Style="{StaticResource Hint}" />
                                    <TextBlock Grid.Column="3" Text="Y, %" Style="{StaticResource Hint}" />
                                    <TextBlock Grid.Row="1" Text="Підказки" Style="{StaticResource Label}" />
                                    <TextBox x:Name="HintsX" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                                    <TextBox x:Name="HintsY" Grid.Row="1" Grid.Column="3" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Таймер" Style="{StaticResource Label}" />
                                    <TextBox x:Name="TimerX" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                    <TextBox x:Name="TimerY" Grid.Row="2" Grid.Column="3" Margin="0,4" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Відсоток від ширини і висоти вікна гри, від лівого верхнього кута. Меню F9 стає праворуч від гри саме." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Таймер -->
                    <StackPanel x:Name="PageTimer" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Таймер" Style="{StaticResource CardTitle}" />
                                <CheckBox x:Name="TimerEnabled" Content="Показувати таймер над грою" />
                                <CheckBox x:Name="TimerAutoStart" Content="Стартувати автоматично при вході в Twilight Strand (Act 1)" Margin="0,6,0,0" />
                                <CheckBox x:Name="TimerShowNext" Content="Показувати рядок «Далі» з часом рекорду" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Порівняння" Style="{StaticResource CardTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Порівнювати з" Style="{StaticResource Label}" />
                                    <ComboBox x:Name="ComparisonBox" Grid.Column="1" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Особистий рекорд (PB)" Tag="PersonalBest" />
                                        <ComboBoxItem Content="Минулий забіг" Tag="LastRun" />
                                        <ComboBoxItem Content="Сума найкращих сегментів" Tag="SumOfBest" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="TimerSameOptions" Content="Лише забіги з тими самими опціями білда" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Зелений — попереду, червоний — позаду, золотий — найкращий сегмент за всю історію." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Клавіші -->
                    <StackPanel x:Name="PageKeys" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl x:Name="HotkeysList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="240" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                                                         PreviewKeyDown="OnHotkeyKeyDown" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                                                         ToolTip="Клацніть і натисніть комбінацію. Backspace — очистити." />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Клацніть у поле і натисніть комбінацію. Хоткеї працюють лише з увімкненим оверлеєм; зайняті іншою програмою клавіші будуть показані при збереженні." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Оновлення -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="VersionText" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Джерело оновлень" Margin="0,0,0,4" />
                                <TextBox x:Name="UpdateSource" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Посилання на GitHub-репозиторій з релізами, URL або папка з вмістом releases/." />
                                <CheckBox x:Name="CheckUpdatesOnStart" Content="Перевіряти при запуску" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="UpdateButton" Content="Перевірити оновлення" Click="OnUpdate" />
                                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
