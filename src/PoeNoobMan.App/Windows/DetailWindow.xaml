<local:OverlayWindowBase x:Class="PoeNoobMan.App.Windows.DetailWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="clr-namespace:PoeNoobMan.App.Windows"
                         Title="PoE Noob Man — меню">
    <Border x:Name="Root" Width="440" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource OverlayBorder}" BorderThickness="1">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <DockPanel>
            <!-- Заголовок -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OverlayButton}" Click="OnClose" ToolTip="Закрити (F9)" />
                <StackPanel>
                    <TextBlock x:Name="Title1" Foreground="{StaticResource OverlayText}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Title2" Foreground="{StaticResource OverlayMuted}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <!-- Рівень і очки -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Рівень" Foreground="{StaticResource OverlayMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Content="−" Style="{StaticResource OverlayButton}" Click="OnLevelDown" />
                <TextBlock x:Name="LevelText" Foreground="{StaticResource OverlayText}" FontSize="14" MinWidth="26" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Content="+" Style="{StaticResource OverlayButton}" Click="OnLevelUp" />
                <TextBlock Text="Очки" Foreground="{StaticResource OverlayMuted}" VerticalAlignment="Center" Margin="16,0,4,0" />
                <Button Content="−" Style="{StaticResource OverlayButton}" Click="OnPointsDown" />
                <TextBlock x:Name="PointsText" Foreground="{StaticResource OverlayText}" FontSize="14" MinWidth="26" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Content="+" Style="{StaticResource OverlayButton}" Click="OnPointsUp" />
            </StackPanel>

            <!-- Наступна нода -->
            <Border DockPanel.Dock="Top" Background="#2C2C2A" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                <DockPanel>
                    <Button x:Name="TakeNodeButton" DockPanel.Dock="Right" Content="Взято" Style="{StaticResource OverlayButton}" Click="OnTakeNode" VerticalAlignment="Center" />
                    <TextBlock x:Name="NodeText" Foreground="{StaticResource OverlayText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Скидання -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button x:Name="ResetButton" Content="Скинути прогрес" Style="{StaticResource OverlayButton}" HorizontalAlignment="Left" Click="OnResetAsk" />
                <StackPanel x:Name="ResetConfirm" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Скинути весь прогрес персонажа?" Foreground="{StaticResource Behind}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="Так, скинути" Style="{StaticResource OverlayButton}" Click="OnResetYes" />
                    <Button Content="Ні" Style="{StaticResource OverlayButton}" Click="OnResetNo" />
                </StackPanel>
            </StackPanel>

            <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                        ItemContainerStyle="{StaticResource OverlayTab}">
                <TabItem Header="Кроки" Focusable="False">
                    <ScrollViewer x:Name="StepsScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="StepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="4,2" CornerRadius="3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Act}" Foreground="{StaticResource OverlayDim}" FontSize="11" Width="28" Margin="0,2,0,0" />
                                            <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" Click="OnStepClick" Tag="{Binding Id}" Style="{StaticResource OverlayCheck}">
                                                <StackPanel>
                                                    <TextBlock x:Name="StepText" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource OverlayText}" FontSize="12" />
                                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{StaticResource OverlayDim}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasNote}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </CheckBox>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#3A3527" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocker}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#2C2C2A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter TargetName="StepText" Property="Foreground" Value="{StaticResource OverlayDim}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Дерево" Focusable="False">
                    <ScrollViewer x:Name="TreeScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="TreeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="4,2" CornerRadius="3">
                                        <CheckBox IsChecked="{Binding IsTaken, Mode=OneWay}" Click="OnNodeClick" Tag="{Binding Id}" Style="{StaticResource OverlayCheck}">
                                            <StackPanel>
                                                <TextBlock x:Name="NodeName" Text="{Binding Name}" TextWrapping="Wrap" Foreground="{StaticResource OverlayText}" FontSize="12" />
                                                <TextBlock Text="{Binding Condition}" Foreground="{StaticResource OverlayDim}" FontSize="11" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsNow}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#3A3527" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#2C2C2A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTaken}" Value="True">
                                            <Setter TargetName="NodeName" Property="Foreground" Value="{StaticResource OverlayDim}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Забіг" Focusable="False">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Старт / спліт" Style="{StaticResource OverlayButton}" Click="OnTimerSplit" />
                            <Button Content="Скасувати спліт" Style="{StaticResource OverlayButton}" Click="OnTimerUndo" />
                            <Button Content="Скинути" Style="{StaticResource OverlayButton}" Click="OnTimerReset" />
                        </StackPanel>
                        <ScrollViewer x:Name="RunScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl x:Name="RunList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource OverlayText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Current}" Foreground="{StaticResource OverlayText}" FontFamily="Consolas" FontSize="12" TextAlignment="Right" />
                                            <TextBlock x:Name="DeltaText" Grid.Column="2" Text="{Binding Delta}" Foreground="{StaticResource OverlayDim}" FontFamily="Consolas" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Best}" Foreground="{StaticResource OverlayMuted}" FontFamily="Consolas" FontSize="12" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding Last}" Foreground="{StaticResource OverlayDim}" FontFamily="Consolas" FontSize="12" TextAlignment="Right" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ahead}" Value="True">
                                                <Setter TargetName="DeltaText" Property="Foreground" Value="{StaticResource Ahead}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Behind}" Value="True">
                                                <Setter TargetName="DeltaText" Property="Foreground" Value="{StaticResource Behind}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</local:OverlayWindowBase>
